# Supabase — Project Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxx

# Supabase service_role 키 — 절대 클라이언트에 노출 금지, 서버(API route)에서만 사용
# (관리자 심사 승인, official 데이터 적재 등 RLS를 우회해야 하는 작업 전용)
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx

# 관리자로 취급할 이메일 목록 (콤마로 구분)
ADMIN_EMAILS=admin@example.com

# 카카오맵 — Kakao Developers > 내 애플리케이션 > JavaScript 키
NEXT_PUBLIC_KAKAO_MAP_KEY=xxxxxxxx

# 공공데이터포털(data.go.kr) — 사용할 화장실 데이터셋의 OpenAPI 활용신청 후 발급받은 인증키/URL
# 데이터셋마다 요청 URL과 응답 필드명이 달라 src/lib/publicData/toilets.ts의 매핑을 데이터셋에 맞게 조정해야 함
DATA_GO_KR_SERVICE_KEY=xxxxxxxx
DATA_GO_KR_TOILET_API_URL=https://api.odcloud.kr/api/xxxxxxxx
